rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return isSignedIn() && request.auth.uid == uid;
    }

    function userDocKeysOk() {
      return request.resource.data.keys().hasOnly([
        'createdAt',
        'lastActiveAt',
        'platform',
        'locale',
        'credits',
        'onboardingCompleted',
        'notificationsEnabled'
      ]);
    }

    function freeCreditsCreateOk() {
      return request.resource.data.credits is int
        && request.resource.data.credits == 3
        && request.resource.data.platform is string
        && request.resource.data.locale is string
        && request.resource.data.onboardingCompleted == false
        && request.resource.data.notificationsEnabled == false;
    }

    function preferenceUpdateOk() {
      return request.resource.data.diff(resource.data).affectedKeys()
        .hasOnly(['onboardingCompleted', 'notificationsEnabled', 'lastActiveAt', 'locale']);
    }

    match /users/{uid} {
      allow read: if isOwner(uid);

      // First-time anonymous profile with exactly 3 free credits.
      allow create: if isOwner(uid)
        && userDocKeysOk()
        && freeCreditsCreateOk();

      // Preferences only — never credits / platform / createdAt.
      allow update: if isOwner(uid) && preferenceUpdateOk();

      allow delete: if false;

      match /purchases/{purchaseId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /credit_ledger/{ledgerId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /jobs/{jobId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /devices/{tokenHash} {
        allow read: if isOwner(uid);
        // Token registration will be tightened with Cloud Functions later.
        allow create, update: if isOwner(uid)
          && request.resource.data.keys().hasOnly(['token', 'platform', 'updatedAt']);
        allow delete: if isOwner(uid);
      }
    }

    match /config/{docId} {
      allow read: if isSignedIn();
      allow write: if false;
    }
  }
}
