# Server
PORT=8787
NODE_ENV=development

# Gemini (never put this in the Flutter app)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.0-flash-preview-image-generation

# Firebase Admin — path to service account JSON (Auth + Firestore)
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json
FIREBASE_PROJECT_ID=photofixer-4bc1f

# Cloudflare R2 (S3-compatible)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=photofixer-tmp
R2_PUBLIC_BASE_URL=
# If empty, API returns short-lived signed URLs instead
R2_SIGNED_URL_TTL_SECONDS=900

# Limits
MAX_IMAGE_BYTES=12582912
ANON_RATE_LIMIT_PER_HOUR=5
